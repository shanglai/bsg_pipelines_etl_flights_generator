# Copia este archivo a .env y cambia los valores. NUNCA subas .env a Git.

# --- Imágenes (cámbialas si Docker Hub te limita; por ejemplo mirror.gcr.io/library/mysql:8.4)
IMAGEN_PYTHON=python:3.11-slim
IMAGEN_MYSQL=mysql:8.4
IMAGEN_SFTP=atmoz/sftp:alpine

# --- Modo y reloj
SIM_MODO=local
# 60 => 1 minuto real = 1 hora simulada. En modo servidor se usa 1.
SIM_FACTOR=60
# activos | limpio  (limpio = sin errores de datos ni llegadas tarde; para pruebas)
SIM_ERRORES=activos

# --- Puertos publicados en tu máquina
API_PUERTO=8000
SFTP_PUERTO=2222
MYSQL_PUERTO=3307

# --- Credenciales de ejemplo para el alumno (modo local)
ALUMNO_MYSQL_USUARIO=alumno
ALUMNO_MYSQL_CONTRASENA=cambia-esta-contrasena
ALUMNO_SFTP_USUARIO=alumno
ALUMNO_SFTP_CONTRASENA=cambia-esta-contrasena
ALUMNO_API_LLAVE=cambia-esta-llave

# --- Solo instructor
MYSQL_ROOT_PASSWORD=cambia-esta-contrasena-root
TOKEN_INSTRUCTOR=cambia-este-token
